{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netechconnect.example/schemas/source.schema.json",
  "title": "EventSource",
  "description": "One event source, stored as data/sources/<id>.yaml (YAML validated against this JSON Schema).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "url", "connector", "trust", "origin", "status", "approved_count",
               "rejected_count", "check_interval_hours", "rate_limit_seconds", "added_at"],
  "$defs": {
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://[^/\\s]+\\.[^/\\s]+(/.*)?$", "maxLength": 2048 }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^src_[a-z0-9-]{1,80}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "url": { "$ref": "#/$defs/httpsUrl" },
    "feed_url": { "anyOf": [{ "$ref": "#/$defs/httpsUrl" }, { "type": "null" }] },
    "connector": { "enum": ["ical", "rss", "jsonld", "eventbrite_org", "html_rules"] },
    "trust": { "enum": ["trusted", "probationary"] },
    "origin": { "enum": ["preconfigured", "admin", "discovered", "suggested"] },
    "found_via": { "enum": ["web_search", "link_graph", "newsletter", "news", "platform", "gap", "suggestion", null] },
    "status": { "enum": ["active", "paused", "blocked_by_terms"] },
    "organizer_id": { "type": ["string", "null"] },
    "default_area": { "enum": ["omaha", "lincoln", "other_ne", "online", null] },
    "default_cost": { "enum": ["free", null] },
    "approved_count": { "type": "integer", "minimum": 0 },
    "rejected_count": { "type": "integer", "minimum": 0 },
    "check_interval_hours": { "type": "integer", "minimum": 1, "maximum": 24 },
    "rate_limit_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "html_rules": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "item": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 200 },
        "start": { "type": "string", "maxLength": 200 },
        "link": { "type": "string", "maxLength": 200 },
        "location": { "type": "string", "maxLength": 200 }
      }
    },
    "follow_links": {
      "type": ["object", "null"],
      "description": "jsonld only: also read same-site pages linked from url whose path matches path_glob (e.g. /live/nenug-*), up to max_pages.",
      "additionalProperties": false,
      "required": ["path_glob"],
      "properties": {
        "path_glob": { "type": "string", "pattern": "^/", "maxLength": 200 },
        "max_pages": { "type": "integer", "minimum": 1, "maximum": 25 }
      }
    },
    "notes": { "type": ["string", "null"], "maxLength": 1000 },
    "added_at": { "type": "string", "format": "date" },
    "updated_at": { "type": ["string", "null"], "format": "date" }
  }
}
