{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netechconnect.example/schemas/override.schema.json",
  "title": "Override",
  "description": "An administrator correction applied after every pipeline run, stored as an item of data/overrides.yaml. Cannot change original_url, review_state, or trust (FR-019, FR-045).",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "reason"],
  "properties": {
    "event_id": { "type": "string", "pattern": "^evt_[a-f0-9]{12}$" },
    "visibility": { "enum": ["shown", "hidden"] },
    "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "area": { "enum": ["omaha", "lincoln", "other_ne", "online"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 280 }
  }
}
